# --- App
ENV=dev
API_PORT=8000
FRONT_PORT=5173

# --- Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database
POSTGRES_DB=restau
POSTGRES_USER=restau
POSTGRES_PASSWORD=restau
DATABASE_URL=postgresql+psycopg://restau:restau@db:5432/restau

# --- Storage
STORAGE_PATH=/app/storage

# --- CORS (dev)
CORS_ORIGINS=http://localhost:5173

# --- Mail (optional, for temporary password emails)
APP_BASE_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# --- MyRHIS (external API)
MYRHIS_BASE_URL=https://api.myrhis.fr/your-client
MYRHIS_API_KEY=your-myrhis-api-key
MYRHIS_USERNAME=your-myrhis-username
MYRHIS_PASSWORD=your-myrhis-password
MYRHIS_TIMEOUT_SECONDS=10
MYRHIS_MAX_RESTAURANT_PAGES=25
